{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RouteTable",
  "type": "object",
  "required": ["resource_type", "resource_id", "account_id", "account_name", "region"],
  "properties": {
    "resource_type":           { "type": "string", "const": "aws::ec2::route_table" },
    "resource_id":             { "type": "string" },
    "account_id":              { "type": "string" },
    "account_name":            { "type": "string" },
    "region":                  { "type": "string" },
    "vpc_id":                  { "type": "string" },
    "is_main":                 { "type": "boolean" },
    "associated_subnet_ids":   { "type": "array", "items": { "type": "string" } },
    "routes":                  { "type": "array" },
    "tags":                    { "type": "object" },
    "relationships":           { "type": "array" },
    "collected_at":            { "type": "string", "format": "date-time" }
  }
}
